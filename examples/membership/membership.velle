-- Membership: a streaming-service membership system — the second Velle spec.
-- Complements billing.velle by exercising what it doesn't: optional fields and
-- narrowing (`is some`, `?.`), an optional self-relationship, or-composition and
-- refinement-of-refinement chains, the ledger pattern with latest(...), the
-- flag-witness guard, min/lowercase, `tolerates duplication`, `initially today`,
-- `timestamp on update`, count over shape-name and inferred collections, `as`
-- bindings with a reach-back, a sibling join, bare `frozen`, an act-sourced
-- capture read at exit, the reconciliation latch pair, episodes as data with
-- the refinement-subject singular query (`(OpenDelinquencyFlag for this)`),
-- `then` ordering, the compact `for` creation form, `tolerates loss`, mixed
-- `on commit, <tick>` triggers, and a pure-classification refinement (rung 1).
--
-- Comment convention (as in billing.velle): plain comments tell the business
-- story; `velle:` comments note the language machinery on show.

-- ── Plans and members ────────────────────────────────────────────────────────

-- A streaming service: members subscribe to a priced plan, may have been
-- referred by another member, and carry a balance that deposits top up and
-- renewal charges draw down. The email on file is whatever they gave us most
-- recently, normalized to lowercase.
-- velle: optional self-relationship, `timestamp on update`, a derived property
-- reading the email-change ledger below
expose shape Plan {
    name: text
    price: decimal
} using MockHarness

expose shape Member {
    name: text
    signupEmail: text
    plan: one Plan
    referredBy: one Member?
    joinedOn: timestamp on create
    lastChangedOn: timestamp on update
    balance: decimal initially 0
    lowestBalance: decimal initially 0
    visitCount: long initially 0 tolerates duplication
    suspended: boolean initially false
    engagementScore: double initially 0
    totalDeposited: decimal = sum(deposits, amount)
    email: text = if exists EmailChange for this then
                  lowercase(latest(EmailChange for this).newEmail)
                  else lowercase(signupEmail)
} using MockHarness

-- Nobody gets referral credit for referring themselves.
-- velle: a named-refinement `never`; input-constrained, enforced at the boundary
shape SelfReferral = Member where referredBy is some and referredBy == this
never SelfReferral

-- Every new member is welcomed the moment they join.
-- velle: the compact `for` creation form
shape WelcomeNote {
    member: one Member
    sentOn: DateTime
}

rule SendWelcome when Member {
    WelcomeNote for this sentOn: now
}

-- ── Email changes ────────────────────────────────────────────────────────────

-- Members change their email over time, and the history matters — old
-- addresses explain old notifications. Nothing is edited: every change is
-- kept, and the current email is simply the newest one.
-- velle: the ledger pattern — ordered by the ledger shape's sole creation
-- timestamp, derived `email` above selects the latest
expose shape EmailChange {
    member: one Member
    newEmail: text
    changedOn: timestamp on create
} using MockHarness

-- ── Visits ───────────────────────────────────────────────────────────────────

-- Every visit bumps the member's visit counter. The counter feeds
-- recommendations, so a rare double-count is a shrug, not an incident.
expose shape Visit {
    member: one Member
    minutes: integer
} using MockHarness

never (Visit where minutes <= 0)

-- velle: unguarded self-referential fold on a backstopped cadence — the
-- duplication hazard is real and signed on the field (`tolerates duplication`,
-- README §19)
rule CountVisit when Visit on commit, Hourly {
    member.visitCount = member.visitCount + 1
}

-- Each visit also pings the analytics pipeline. If a ping goes missing,
-- nobody minds.
-- velle: previews the external-effect escape — the ping may be dropped
-- (`tolerates loss`; README §11, "forced boundaries")
shape AnalyticsPing {
    visit: one Visit
    pingedOn: DateTime
}

rule PingAnalytics when Visit tolerates loss {
    AnalyticsPing from { visit: this, pingedOn: now }
}

-- ── Deposits ─────────────────────────────────────────────────────────────────

-- Members top up their balance with deposits. A deposit must land on the
-- balance exactly once — promptly, and even if the system crashes mid-way.
-- velle: the flag-witness guard, `after commit` with an hourly backstop
expose shape Deposit {
    member: one Member
    amount: decimal
    applied: boolean initially false
} using MockHarness

never (Deposit where amount <= 0)

shape UnappliedDeposit = Deposit where not applied

rule ApplyDeposit when UnappliedDeposit after commit, Hourly {
    member.balance = member.balance + amount
    this.applied = true
}

-- ── Renewal charges ──────────────────────────────────────────────────────────

-- Active members are charged their plan price monthly — never more than one
-- charge per 30 days, and suspended members are not charged at all. The
-- charge is recorded first, then applied to the balance exactly once, so a
-- crash can never lose track of money in flight.
-- velle: intent before effect; a time-windowed guard on the tick; the
-- evidence-witness guard on the apply
shape Charge {
    member: one Member
    amount: decimal
    reference: text initially randomUUID
    requestedOn: Date initially today
}

shape ActiveMember = Member where not suspended

rule RenewMembership
    when (ActiveMember where
          not exists (Charge where member == this and requestedOn > today - 30 days))
    on Monthly {
    Charge from { member: this, amount: plan.price }
}

shape ChargeApplication {
    charge: one Charge
    appliedOn: DateTime
}

shape UnappliedCharge = Charge where not exists ChargeApplication for this

rule ApplyCharge when UnappliedCharge after commit, Hourly {
    member.balance = member.balance - amount
    ChargeApplication from { charge: this, appliedOn: now }
}

-- ── Delinquency ──────────────────────────────────────────────────────────────

-- A member whose balance has gone negative is delinquent.
shape Delinquent = Member where balance < 0

-- Deeply negative accounts are worth reporting on — but nothing acts on the
-- classification, so it is just a question the data can answer.
-- velle: rung 1, pure classification — no rule, no machinery
shape DeepDelinquent = Member where balance < -100

-- We track the worst balance each member has ever hit.
-- velle: a whitelisted fold (min): duplication- and order-insensitive, no guard owed
rule TrackLowestBalance when Delinquent {
    this.lowestBalance = min(this.lowestBalance, this.balance)
}

-- Delinquent members lose service overnight, and get it back the night after
-- they recover. A dip that opens and closes within the same day never
-- matters.
-- velle: rung 2, the reconciliation latch pair — idempotent nightly sweeps,
-- transient blips deliberately unobserved
rule SuspendDelinquents when (Delinquent where not suspended) on Nightly {
    this.suspended = true
}

rule RestoreService when (Member where suspended and balance >= 0) on Nightly {
    this.suspended = false
}

-- Each stretch of delinquency is an episode with a beginning and an end, so
-- the business can ask "how many times has this member gone delinquent, and
-- for how long?" Going delinquent opens a flag; recovering closes it.
-- velle: rung 3, episodes as data — the flag/resolution pair makes each
-- episode a queryable fact
shape DelinquencyFlag {
    member: one Member
    flaggedOn: Date
}

shape DelinquencyResolution {
    flag: one DelinquencyFlag
    resolvedOn: Date
}

shape OpenDelinquencyFlag = DelinquencyFlag where not exists DelinquencyResolution for this

rule OpenDelinquencyEpisode
    when (Delinquent where not exists OpenDelinquencyFlag for this) {
    DelinquencyFlag from { member: this, flaggedOn: today }
}

-- velle: `(OpenDelinquencyFlag for this)` is the proof-gated singular query
-- with a refinement subject (singular_references.md): licensed because the
-- entry rule's own guard proves at most one open flag per member
rule CloseDelinquencyEpisode when leaving Delinquent {
    DelinquencyResolution from {
        flag: (OpenDelinquencyFlag for this)
        resolvedOn: today
    }
}

-- A third episode makes a member chronic: open an account review — once,
-- ever — writing the audit trail before the review itself.
-- velle: count over a shape-name collection, a `then` ordering, and a mixed
-- commit-plus-tick trigger
shape ChronicDelinquent = Member where count(DelinquencyFlag where member == this) >= 3

shape AuditEntry {
    member: one Member
    note: text
    loggedOn: DateTime
}

shape AccountReview {
    member: one Member
    openedOn: DateTime
}

rule OpenAccountReview
    when (ChronicDelinquent where not exists (AccountReview where member == this))
    on commit, Daily {
    AuditEntry from { member: this, note: "account review opened", loggedOn: now }
    then
    AccountReview from { member: this, openedOn: now }
}

-- ── Nightly engagement snapshot ──────────────────────────────────────────────

-- Each night, every member's engagement score is refreshed from their visit
-- history — a stable overnight figure dashboards can quote all day.
-- velle: the recompute rung — a snapshot, deliberately stable between ticks
rule ScoreEngagement when Member on Nightly {
    this.engagementScore = count(visits)
}

-- ── Support desk: agents and tickets ─────────────────────────────────────────

-- Members raise support tickets, worked by agents. A ticket may sit
-- unassigned; its contact address falls back to the shared desk until an
-- agent picks it up. Priority is one of low, normal, high.
-- velle: optional to-one narrowing — `?.` propagation and `is some`-licensed `.`
expose shape Agent {
    name: text
    email: text
} using MockHarness

expose shape Ticket {
    member: one Member
    subject: text
    due: Date
    priority: text
    assignee: one Agent?
    openedOn: timestamp on create
    assigneeEmail: text? = assignee?.email
    contact: text = if assignee is some then assignee.email else "support@velle.example"
} using MockHarness

never (Ticket where priority != "low" and priority != "normal" and priority != "high")

-- ── Closing freezes the whole ticket ─────────────────────────────────────────

-- A closed ticket is settled history: nothing on it may change. Reopening it
-- notifies whoever closed it — with a suggestion to take it back — since they
-- had the context.
-- velle: bare `frozen`, act-sourced captures, and the capture's last reader
-- at `when leaving`
expose shape CloseTicket {
    ticket: one Ticket
    closedBy: one Agent
} using MockHarness

expose shape ReopenTicket {
    ticket: one Ticket
} using MockHarness

shape ClosedTicket = Ticket where
    exists CloseTicket for this and not exists ReopenTicket for this {
    frozen
    captured closedOn: Date = today
    captured closedBy: one Agent = latest(CloseTicket where ticket == this).closedBy
}

shape ReopenNotice {
    ticket: one Ticket
    reassignTo: one Agent
    noticedOn: DateTime
}

rule NoticeReopen when leaving ClosedTicket {
    ReopenNotice from { ticket: this, reassignTo: closedBy, noticedOn: now }
}

-- Assigning an agent to a closed ticket is refused, and the refusal is on
-- record for the person who tried. The assignment request is a message, not
-- a record: decided at its own commit, not kept — the refusal copies what it
-- needs.
-- velle: rejection as data over a `transient` act, partitioned on the freeze;
-- the complement pair proves every request gets a response (V18)
expose transient shape AssignTicket {
    ticket: one Ticket
    agent: one Agent
} using MockHarness

shape ApplicableAssignment = AssignTicket where not ticket is ClosedTicket
shape RefusedAssignment    = AssignTicket where ticket is ClosedTicket

rule ApplyAssignment when ApplicableAssignment {
    ticket.assignee = agent
}

shape AssignmentRefusal {
    ticket: one Ticket
    agent: one Agent
    reason: text
    refusedOn: DateTime
}

rule RecordAssignmentRefusal when RefusedAssignment {
    AssignmentRefusal from { ticket: ticket, agent: agent, reason: "ticket is closed", refusedOn: now }
}

-- ── Attention traits ─────────────────────────────────────────────────────────

-- What deserves attention: a ticket that is overdue or high-priority. If it
-- is also sitting unassigned, it is urgent — and urgent tickets escalate
-- daily, though no ticket escalates more than once every two days.
-- velle: small trait-style refinements composed with and/or
shape OpenTicket     = Ticket where not this is ClosedTicket
shape OverdueTicket  = OpenTicket where due < today
shape HighPriority   = Ticket where priority == "high"
shape Unassigned     = Ticket where assignee is none
shape NeedsAttention = OverdueTicket or HighPriority
shape UrgentQueue    = NeedsAttention and Unassigned

shape Escalation {
    ticket: one Ticket
    raisedOn: Date
}

rule EscalateUrgent
    when (UrgentQueue where
          not exists (Escalation where ticket == this and raisedOn > today - 2 days))
    on Daily {
    Escalation from { ticket: this, raisedOn: today }
}

-- ── Cross-collection classifications ─────────────────────────────────────────

-- A member disputing a charge is spotted when one of their tickets quotes one
-- of their charges' reference numbers in its subject.
-- velle: a sibling join — two collections correlated against each other
shape MemberWithDisputedCharge = Member where
    exists (tickets as tix, charges as ch where tix.subject == ch.reference)

-- A member let down twice: a ticket that was escalated only after its own due
-- date had already passed.
-- velle: an `as` reach-back — the inner filter reads the middle level's field
shape LateEscalatedMember = Member where
    exists (tickets as tix where count(escalations where raisedOn > tix.due) >= 1)
