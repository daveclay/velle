-- An assignment in a block through a name that is not the block's, 'member.lastRenewed' inside 'for each loan in member.loans'; it would be written once per loan.
act Member { name: text, lastRenewed: Date? }
act Loan { member: one Member, dueOn: Date }
transient act Renew { member: one Member }

rule Extend when Renew {
    for each loan in member.loans {
        member.lastRenewed = today
    }
}
