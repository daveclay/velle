-- A stored field declared required and started through a selection, `initially first(patient.visits by seenOn).seenOn`, with no test showing the patient has a visit; the selection matches nothing for a patient with none.
act Patient {
    name: text
    visits: many Visit = (Visit where patient == this)
}
act Visit {
    patient: one Patient
    seenOn: Date
}
act OpenChart {
    patient: one Patient
}
shape Chart {
    patient: one Patient
    opened: Date initially first(patient.visits by seenOn).seenOn
}
rule Open when OpenChart {
    Chart from { patient: patient }
}
