-- A write through a collection whose value reads the same collection, 'member.loans.renewals = member.loans.renewals + 1'; the right side is every loan's count at once, a collection, not one number.
act Member { name: text }

act Loan {
    member: one Member
    dueOn: Date
    renewals: integer initially 0
    flagged: boolean initially false
}

transient act Renew { member: one Member }

rule Extend when Renew {
    member.loans.renewals = member.loans.renewals + 1
}
