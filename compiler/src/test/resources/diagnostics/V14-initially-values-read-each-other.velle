-- Two stored fields whose `initially` values read each other, `doubled` starting from `base` and `base` from `doubled`; neither can be computed first.
act Patient {
    name: text
}
act OpenChart {
    patient: one Patient
}
shape Chart {
    patient: one Patient
    doubled: integer initially base * 2
    base: integer initially doubled + 1
}
rule Open when OpenChart {
    Chart from { patient: patient }
}
