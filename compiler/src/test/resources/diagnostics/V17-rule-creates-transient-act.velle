-- A rule creating a transient act, 'RenewLoan from { loan: loan }' inside 'for each'; a transient act arrives from outside, so a rule never creates one.
act Member { name: text }

act Loan {
    member: one Member
    dueOn: Date
    renewals: integer initially 0
    flagged: boolean initially false
}

transient act Renew { member: one Member }

transient act RenewLoan { loan: one Loan }

rule Spread when Renew {
    for each loan in (member.loans where dueOn < today) {
        RenewLoan from { loan: loan }
    }
}

rule Count when RenewLoan {
    loan.renewals = loan.renewals + 1
}
