-- An assignment inside `for each`, written through the loop's own name.
-- The compiler refuses it with V34, which is the message an author needs, and with a
-- second message, F1, that calls the loop name an unknown member.
act Item { label: text, n: integer }
act Batch { items: many Item, n: integer }

rule Tag when Batch {
    for each item in items {
        item.n = 1
    }
}
