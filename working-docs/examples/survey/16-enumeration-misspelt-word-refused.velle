-- The same spec with one word misspelt in a refinement: "numbr". The compiler
-- reads the word against the declaration and refuses it where it is written,
-- naming the three words (checks F2).
FieldType is one of "number", "date", "text"

act Field {
    name: text unique
    type: FieldType
}

shape NumberField = Field where type == "numbr"

shape Reading {
    fieldName: text
    numberValue: decimal?
    field: one Field? =
        if exists (Field where name == this.fieldName) then first(Field where name == this.fieldName by name)
        else none
}

never (Reading where field is some and field is NumberField and numberValue is none)
