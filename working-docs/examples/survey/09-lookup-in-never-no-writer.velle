-- Probe for the lookup pattern (wiki/patterns.md, "An act that names a record by its values"): the same never over readings with nothing assigning Field.name.
-- A field is named by its kind and its own name together: the key `unique (kindName, name)` (Reference §21, "Keys").
act Field {
    kindName: text
    name: text
    options: many text
    unique (kindName, name)
}

act Submission {
    kindName: text
}

act Reading {
    submission: one Submission
    fieldName: text
    value: text?
}

never (Reading where not exists (Field where kindName == this.submission.kindName and name == this.fieldName))
never (Reading where value is some
    and not exists (Field where kindName == this.submission.kindName and name == this.fieldName
                    and exists (options as o where o == this.value)))
