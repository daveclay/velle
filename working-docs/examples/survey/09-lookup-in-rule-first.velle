-- Probe for the lookup pattern (wiki/patterns.md, "An act that names a record by its values"): the lookup in a rule's `from`.
-- `key: text unique` is the key (Reference §21, "Keys"), so `(Entry where key == this.entryKey)` is one entry or absent and
-- needs no `by`; the existence never keeps the absent case out at the door. `first(Entry where key == this.entryKey by key)`
-- is the spelling for a shape without a key.
act Entry {
    key: text unique
    initialLabel: text
    arrivals: many Arrival = (Arrival where entry == this)
}

act Submission {
    entryKey: text
    newLabel: text?
}

never (Submission where not exists (Entry where key == this.entryKey))

shape Arrival {
    submission: one Submission
    entry: one Entry
}

shape Unpaired = Submission where not exists Arrival for this

rule RecordArrival when Unpaired {
    Arrival from { submission: this, entry: (Entry where key == this.entryKey) }
}
