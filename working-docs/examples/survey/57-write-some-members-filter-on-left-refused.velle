-- "Flag every late loan of this member." The write is wanted on some members of a
-- collection, the late ones. An assignment's left side is a fixed path, so a filter
-- cannot stand there, and the parser refuses the statement.
act Member { name: text }

act Loan {
    member: one Member
    dueOn: Date
    renewals: integer initially 0
    flagged: boolean initially false
}

transient act FlagLate { member: one Member }

rule Flag when FlagLate {
    (member.loans where dueOn < today).flagged = true
}
