-- The same sentence with the refusal kept as a record: ApplyClose deletes
-- only a seller nothing holds, and RefuseClose records the request that was
-- turned away. Check V24 reads the condition `seller is not held`.

act Seller {
    name: text
}

act Listing {
    title: text
    seller: one Seller
}

transient act CloseAccount {
    seller: one Seller
}

shape CloseRefusal {
    sellerName: text
    refusedOn: timestamp on create
}

rule ApplyClose when (CloseAccount where seller is not held) {
    delete seller
}

rule RefuseClose when (CloseAccount where seller is held) {
    CloseRefusal from { sellerName: seller.name }
}
