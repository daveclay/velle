-- The submission kept, with an outcome record so it is handled once.
act Submission {
    kindName: text
    readings: many Reading = (Reading where submission == this)
} with readings

shape Reading {
    submission: one Submission
    fieldName: text
    value: text?
}

shape Outcome {
    submission: one Submission
    handledAt: timestamp on create
}

never (Submission where exists (readings where value is none))

shape Unhandled = Submission where not exists Outcome for this

rule Handle when Unhandled {
    Outcome from { submission: this }
}
