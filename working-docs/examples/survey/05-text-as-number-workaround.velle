act Field {
    name: text
    type: text
    min: decimal?
}

shape Reading {
    fieldName: text
    value: text?
    field: one Field? =
        if exists (Field where name == this.fieldName) then first(Field where name == this.fieldName by name)
        else none
}

-- Only the shape of the text can be checked. The minimum is not.
never (Reading where field is some and field.type == "number" and value is some
       and not (value matches "-?[0-9]+([.][0-9]+)?"))
