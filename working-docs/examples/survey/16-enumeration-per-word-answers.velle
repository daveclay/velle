-- A request that carries one of three words, answered one word at a time: one
-- rule for "approved", one for the other two. Over the declared type the two
-- rules name every word, so the compiler sees every request answered (checks
-- V18). Drop "error" from the second rule and the compiler names it.
shape Entry {
    name: text unique
}

Outcome is one of "approved", "declined", "error"

transient act Review {
    entry: one Entry
    outcome: Outcome
}

shape Approval {
    entry: one Entry
    reviewedOn: timestamp on create
}

shape Failure {
    entry: one Entry
    outcome: Outcome
    reviewedOn: timestamp on create
}

rule RecordApproval when (Review where outcome == "approved") {
    Approval from { entry: entry }
}

rule RecordFailure when (Review where outcome in ["declined", "error"]) {
    Failure from { entry: entry, outcome: outcome }
}
