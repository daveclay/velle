-- "A site visit or a plot inspection is overdue when its due date has passed."
-- Two shapes each declare `due: Date`; a union names them; one refinement over
-- the union reads `due`. Reference §9 does not admit the read, since `due` is
-- two declarations, and the compiler refuses it naming both and offering the
-- two spellings. The direct spelling is 17-shared-field-is-direct.velle.
shape Site {
    name: text unique
}

shape SiteVisit {
    site: one Site
    due: Date
}

shape PlotInspection {
    site: one Site
    plot: text
    due: Date
}

shape Dated = SiteVisit or PlotInspection

shape Overdue = Dated where due < today

shape Reminder {
    about: one Dated
    sentOn: Date
}

rule RemindOverdue when Overdue on Daily {
    Reminder from { about: this, sentOn: today }
}
