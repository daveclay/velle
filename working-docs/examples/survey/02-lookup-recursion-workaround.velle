-- The walk unrolled to a fixed depth. A deeper tree is wrong silently.
act Kind {
    name: text
    parentName: text?
    hasLocation: boolean

    parent: one Kind? =
        if parentName is none then none
        else if exists (Kind where name == this.parentName) then first(Kind where name == this.parentName by name)
        else none

    locationHolder: one Kind? =
        if hasLocation then this
        else if parent?.hasLocation then parent
        else if parent?.parent?.hasLocation then parent.parent
        else if parent?.parent?.parent?.hasLocation then parent.parent.parent
        else none
}

never (Kind where count(Kind where name == this.name) > 1)
