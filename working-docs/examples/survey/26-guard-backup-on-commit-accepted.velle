-- A guard and a backup schedule on a rule that fires on commit, not after
-- commit. Reference §18 "What the compiler checks" says this is refused with
-- "did you mean `after commit`?". The compiler accepts it, with no advisory.

act Receipt {
    sentOn: DateTime
}

shape ReceiptEmail {
    receipt: one Receipt
    queuedOn: DateTime
}

shape UnemailedReceipt = Receipt where not exists ReceiptEmail for this

rule EmailReceipt when UnemailedReceipt on commit, Hourly {
    ReceiptEmail from { receipt: this, queuedOn: now }
}
