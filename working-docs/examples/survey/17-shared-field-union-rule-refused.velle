-- "Any change to an entry touches the entry." Two acts each declare
-- `entry: one Entry`; a union names them as one kind of change; one rule over
-- the union reads `entry`. Reference §9 shares across a union only what both
-- operands get from one declaration, and these are two declarations, so the
-- read is refused. The direct spelling is 17-shared-field-is-direct.velle.
shape Entry {
    name: text unique
}

act RenameEntry {
    entry: one Entry
    newName: text
}

act MoveEntry {
    entry: one Entry
    newSite: text
}

shape EntryChange = RenameEntry or MoveEntry

shape Touch {
    entry: one Entry
    touchedOn: timestamp on create
}

rule TouchEntry when EntryChange {
    Touch from { entry: this.entry }
}
