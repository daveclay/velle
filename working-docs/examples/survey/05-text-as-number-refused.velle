-- A number field declares a minimum; a reading's value is text because the
-- field, not the shape, says what it is. A comparison never reads a text as a
-- number (Reference §5; checks.md F2):
--   [F2] 'value < field.min' — compares the text 'value' with a decimal; a text is
--   not compared as a decimal. Write number(value), which is absent when the text
--   is not a number, or declare 'value' as a decimal on a shape of its own
act Field {
    name: text
    type: text
    min: decimal?
}

shape Reading {
    fieldName: text
    value: text?
    field: one Field? =
        if exists (Field where name == this.fieldName) then first(Field where name == this.fieldName by name)
        else none
}

never (Reading where field is some and field.min is some and value is some and value < field.min)
