-- One rule creates a listing for a seller and deletes that seller, in one
-- commit. The compiler accepts it today. The `never` is the hand-written
-- refusal of a request for a seller a listing points at; the listing made
-- here does not exist when the request arrives.

act Seller {
    name: text
}

act Listing {
    title: text
    seller: one Seller? initially required
}

transient act CloseAccount {
    seller: one Seller
}

never (CloseAccount where exists (Listing where seller == this.seller))

rule ApplyClose when CloseAccount {
    Listing from { title: "Closed", seller: seller }
    delete seller
}
