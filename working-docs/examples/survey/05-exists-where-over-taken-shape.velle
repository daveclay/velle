-- OQ139, the where-filtered spelling of the same test, to see whether the
-- taken shape is readable as a collection at all.

act ChargeAttempt {
    amount: integer
}

shape AttemptOutcome {
    attempt: one ChargeAttempt
}

shape ChargeResponse is AttemptOutcome {
    approved: boolean
}

shape AttemptTimeout is AttemptOutcome {
    noticedOn: DateTime
}

shape PendingAttempt = ChargeAttempt where not exists (AttemptOutcome where attempt == this)
