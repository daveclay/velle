-- Four declarations lifted from a larger spec without the shapes they name: Fill,
-- Counselling, and the fields of Fill are not declared here.
-- The compiler names each missing shape, which is what an author needs, and then prints
-- one more F1 about a shape or refinement named '?', a name the author never wrote.
transient act PickUp {
    fill: one Fill
    collectedBy: text
    amountPaid: decimal
}

shape VerifiedFill = Fill where exists (verifications where outcome == "approved")

shape CounsellingDue = VerifiedFill where
    (lot.drug.requiresCounselling or fillNumber == 1) and not exists Counselling for this

never (PickUp where fill is CounsellingDue)
