-- What an author writes today. The request creates one kept record per late loan inside
-- 'for each', and a second rule, fired by each of those records, writes the loan. This
-- covers a filter and a value that differs per member. It costs a kept record per loan
-- per request, RenewalOfLoan, whether or not the business wants that record.
act Member { name: text }

act Loan {
    member: one Member
    dueOn: Date
    renewals: integer initially 0
    flagged: boolean initially false
}

transient act Renew { member: one Member }

act RenewalOfLoan { loan: one Loan }

rule Spread when Renew {
    for each loan in (member.loans where dueOn < today) {
        RenewalOfLoan from { loan: loan }
    }
}

rule Count when RenewalOfLoan {
    loan.renewals = loan.renewals + 1
}
