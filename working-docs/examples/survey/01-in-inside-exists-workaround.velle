act Field {
    kindName: text
    name: text
    options: many text
}

act Submission {
    kindName: text
    readings: many Reading = (Reading where submission == this)
}

shape Reading {
    submission: one Submission
    fieldName: text
    value: text?
    field: one Field? =
        if exists (Field where kindName == this.submission.kindName and name == this.fieldName) then first(Field where kindName == this.submission.kindName and name == this.fieldName by name)
        else none
}

-- The options searched as a collection instead of tested with `in`.
never (Submission where exists (readings as r where
       r.field is some and r.value is some
       and not exists (r.field.options as o where o == r.value)))
