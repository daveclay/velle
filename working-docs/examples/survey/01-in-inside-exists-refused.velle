-- A field is defined by an admin at runtime and lists its allowed options.
-- A reading names its field and carries its value as text.
act Field {
    kindName: text
    name: text
    options: many text
}

act Submission {
    kindName: text
    readings: many Reading = (Reading where submission == this)
}

shape Reading {
    submission: one Submission
    fieldName: text
    value: text?
    field: one Field? =
        if exists (Field where kindName == this.submission.kindName and name == this.fieldName) then first(Field where kindName == this.submission.kindName and name == this.fieldName by name)
        else none
}

-- At the reading's own scope the membership test is accepted.
never (Reading where field is some and value is some and value not in field.options)

-- The same test from the submission, inside an exists, is refused.
never (Submission where exists (readings as r where
       r.field is some and r.value is some and r.value not in r.field.options))
