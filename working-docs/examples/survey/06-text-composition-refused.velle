-- A quantity field stands for two readings: the number, and its unit under
-- the name `<name>_unit`. A text takes part in no arithmetic (Reference §5;
-- checks.md F2):
--   [F2] 'name + "_unit"' — '+' is not defined on a text; Velle does not join or
--   compute with texts. A value made of parts is a shape with a field for each
--   part, and a value that is a number or a date is declared as one
-- The spelling for joining texts is OQ80.
act Field {
    name: text
    isQuantity: boolean
    unitName: text = name + "_unit"
}

shape Reading {
    fieldName: text
    value: text?
    field: one Field? =
        if exists (Field where name == this.fieldName or (isQuantity and unitName == this.fieldName)) then first(Field where name == this.fieldName or (isQuantity and unitName == this.fieldName) by name)
        else none
}
