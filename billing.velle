-- Billing: a small invoicing system — the first Velle spec, and v0's test fixture.
-- Deliberately exercises the full v0 surface: every property kind, relationships,
-- refinements (composition, capture, frozen), guards with disarm proofs, a
-- whitelisted fold, after-commit with a backstop, a tick sweep whose memory is
-- data, when-leaving, rejection-as-data, and input-constrained `never`s.

-- ── Customers ────────────────────────────────────────────────────────────────

expose shape Customer {
    name: text
    email: text
    signedUpOn: timestamp on create
    largestPayment: decimal initially 0
} using MockHarness

expose shape CorrectEmail {
    customer: one Customer
    corrected: text
} using MockHarness

rule ApplyEmailCorrection when CorrectEmail {
    customer.email = corrected
}

-- ── Invoices and line items ──────────────────────────────────────────────────

expose shape Invoice {
    customer: one Customer
    due: Date
    reference: text initially randomUUID
    issuedOn: timestamp on create
    total: decimal = sum(lineItems, amount)
    balance: decimal = total - sum(payments, amount)
    status: text = if balance <= 0 then "paid" else if due < today then "overdue" else "open"
} using MockHarness

expose shape LineItem {
    invoice: one Invoice
    description: text
    price: decimal
    quantity: integer
    amount: decimal = price * quantity
} using MockHarness

never (LineItem where quantity <= 0)
never (LineItem where price < 0)

-- ── Payments ─────────────────────────────────────────────────────────────────

expose shape Payment {
    invoice: one Invoice
    amount: decimal
    receivedOn: timestamp on create
} using MockHarness

never (Payment where amount <= 0)

-- a whitelisted fold (max): duplication- and order-insensitive, so no guard owed
rule TrackLargestPayment when Payment {
    invoice.customer.largestPayment = max(invoice.customer.largestPayment, amount)
}

shape PaidInvoice = Invoice where total > 0 and balance <= 0

shape Receipt {
    invoice: one Invoice
    sentOn: DateTime
}

rule SendReceipt when PaidInvoice {
    Receipt from { invoice: this, sentOn: now }
}

-- durable follow-up: declared boundary, canonical guard, healed hourly
shape UnemailedReceipt = Receipt where not exists ReceiptEmail for this

shape ReceiptEmail {
    receipt: one Receipt
    queuedOn: DateTime
}

rule EmailReceipt when UnemailedReceipt after commit, Hourly {
    ReceiptEmail from { receipt: this, queuedOn: now }
}

-- ── Overdue reminders: a tick sweep whose cross-tick memory is data ──────────

shape OverdueInvoice = Invoice where balance > 0 and due < today

-- composition: overdue and not shelved away
shape ActionableOverdue = OverdueInvoice and not ArchivedInvoice

shape Reminder {
    invoice: one Invoice
    sentOn: Date
}

rule RemindOverdue
    when (ActionableOverdue where
          not exists (Reminder where invoice == this and sentOn > today - 7 days))
    on Weekly {
    Reminder from { invoice: this, sentOn: today }
}

-- ── Issuance freezes the due date ────────────────────────────────────────────

expose shape Issuance {
    invoice: one Invoice
} using MockHarness

shape IssuedInvoice = Invoice where exists Issuance for this {
    frozen due
}

expose shape ChangeDueDate {
    invoice: one Invoice
    newDue: Date
} using MockHarness

-- rejection as data: the act partitions, the writer hangs off the applicable side
shape ApplicableDueChange = ChangeDueDate where not invoice is IssuedInvoice
shape RefusedDueChange    = ChangeDueDate where invoice is IssuedInvoice

rule ApplyDueChange when ApplicableDueChange {
    invoice.due = newDue
}

shape DueChangeRefusal {
    change: one ChangeDueDate
    reason: text
    refusedOn: DateTime
}

rule RecordDueChangeRefusal when RefusedDueChange {
    DueChangeRefusal from { change: this, reason: "invoice is issued", refusedOn: now }
}

-- ── Archival: capture at entry, read at exit ─────────────────────────────────

expose shape ArchiveRequest {
    invoice: one Invoice
} using MockHarness

expose shape UnarchiveRequest {
    invoice: one Invoice
} using MockHarness

shape ArchivedInvoice = Invoice where
    exists ArchiveRequest for this and not exists UnarchiveRequest for this {
    captured archivedOn: Date = today
}

shape UnarchiveNotice {
    invoice: one Invoice
    wasArchivedOn: Date
    noticedOn: DateTime
}

rule NoteUnarchival when leaving ArchivedInvoice {
    UnarchiveNotice from { invoice: this, wasArchivedOn: archivedOn, noticedOn: now }
}
